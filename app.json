{
  "expo": {
    "name": "Personal Assistant",
    "slug": "personal-assistant",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.assistant.personal"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "package": "com.assistant.personal",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "scheme": "personalassistant",
    "plugins": [
      "expo-router",
      [
        "expo-contacts",
        {
          "contactsPermission": "Personal Assistant reads contacts only when you tap Refresh contacts and grant permission. Contact data stays on this device."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Personal Assistant uses your location only when you tap Share current location during an emergency."
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/NotoSerifBengali.ttf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Noto Serif Bengali",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/NotoSerifBengali.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./assets/fonts/NotoSerifBengali.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/NotoSerifBengali.ttf",
                    "weight": 600
                  },
                  {
                    "path": "./assets/fonts/NotoSerifBengali.ttf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/NotoSerifBengali.ttf",
                    "weight": 800
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/NotoSerifBengali.ttf"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "ae85eeb8-6023-46ab-ade7-b060fdb0da49"
      }
    },
    "owner": "hredoymesha"
  }
}

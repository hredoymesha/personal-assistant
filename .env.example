# Copy to .env.local and fill in what you need. .env.local is ignored by git.
# Client IDs are public OAuth settings. Never put a client secret here.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Shows a strip at the top of the web app. Leave empty for normal use.
EXPO_PUBLIC_PREVIEW_LABEL=
# Adds a Download APK button next to the preview strip.
EXPO_PUBLIC_PREVIEW_APK_URL=
